<section class="dashboard">

    <div class="container">

        <!-- HEADER -->

        <header class="dashboard-header">

            <div>

                <h1 class="dashboard-title">
                    Dashboard de Países
                </h1>

                <p class="dashboard-subtitle">

                    Gestión de países hispanohablantes
                    de América

                </p>

            </div>

            <a
                href="/countries/create"
                class="btn btn-primary"
            >
                <i class="fa-solid fa-plus"></i>
                Nuevo País

            </a>

        </header>

        <!-- BÚSQUEDA Y FILTRADO -->

        <form
            action="/countries"
            method="GET"
            class="filters-form"
            aria-label="Filtros de búsqueda"
        >

            <!-- BUSCAR NOMBRE -->

            <input
                type="text"
                name="name"
                placeholder="Buscar país..."
                value="<%= filters?.name || '' %>"
            >

            <!-- CAPITAL -->

            <input
                type="text"
                name="capital"
                placeholder="Capital..."
                value="<%= filters?.capital || '' %>"
            >

            <!-- REGIÓN -->

            <select 
                name="region"
                aria-label="Filtrar por región"
            >

                <option value="">
                    Todas las regiones
                </option>

                <option
                    value="Americas"
                    <%= filters?.region === 'Americas' ? 'selected' : '' %>
                >
                    América
                </option>

            </select>

            <!-- POBLACIÓN -->

            <input
                type="number"
                name="minPopulation"
                min="0"
                placeholder="Población mínima"
                value="<%= filters?.minPopulation || '' %>"
            >

            <input
                type="number"
                name="maxPopulation"
                min="0"
                placeholder="Población máxima"
                value="<%= filters?.maxPopulation || '' %>"
            >

            <button type="submit">

                Filtrar

            </button>

            <a
                href="/countries"
                class="clear-filters"
            >

                Limpiar filtros

            </a>

        </form>

        <!-- EXPORTAR CSV con los filtros aplicados tal como están en el dashboard -->
        <a
            href="/countries/export/csv?name=<%= filters?.name || 
                            '' %>&capital=<%= filters?.capital ||
                            '' %>&region=<%= filters?.region ||
                            '' %>&minPopulation=<%= filters?.minPopulation ||
                            '' %>&maxPopulation=<%= filters?.maxPopulation || '' %>"
            class="btn export-btn"
        >

            Exportar CSV

        </a>

        
        <!-- TABLE WRAPPER -->

        <div class="table-wrapper">

            <table 
                class="countries-table"
                aria-label="Listado de países"
            >

                <thead>

                    <tr>

                        <th>País</th>
                        <th>Capital</th>
                        <th>Fronteras</th>
                        <th>Área</th>
                        <th>Población</th>
                        <th>Gini</th>
                        <th>Zona Horaria</th>
                        <th>Creador</th>
                        <th>Acciones</th>

                    </tr>

                </thead>

                <tbody>

                    <% countries.forEach(country => { %>

                        <tr>

                            <!-- NAME -->

                            <td class="country-name">

                                <%= country.name %>

                            </td>

                            <!-- CAPITAL -->

                            <td>

                                <%= country.capital || 'Sin datos' %>

                            </td>

                            <!-- BORDERS -->

                            <td>

                                <div class="badge-group">

                                    <% if(country.borders?.filter(Boolean).length) { %>

                                        <% country.borders.forEach(border => { %>

                                            <span class="table-badge">

                                                <%= border %>

                                            </span>

                                        <% }) %>

                                    <% } else { %>

                                        <span class="text-muted">

                                            Sin datos

                                        </span>

                                    <% } %>

                                </div>

                            </td>

                            <!-- AREA -->

                            <td>

                                <%= country.area?.toLocaleString() || 'Sin datos' %> km²

                            </td>

                            <!-- POPULATION -->

                            <td>

                                <%= country.population?.toLocaleString() || 'Sin datos' %>

                            </td>

                            <!-- GINI -->

                            <td>

                                <%= country.gini || 'Sin datos' %>

                            </td>

                            <!-- TIMEZONES -->

                            <td>

                                <div class="badge-group">

                                    <% if(country.timezones?.filter(Boolean).length) { %>

                                        <% country.timezones.forEach(zone => { %>

                                            <span class="table-badge timezone">

                                                <%= zone %>

                                            </span>

                                        <% }) %>


                                    <% } else { %>

                                        <span class="text-muted">

                                            Sin datos

                                        </span>

                                    <% } %>

                                </div>

                            </td>

                            <!-- CREADOR -->

                            <td>

                                <%= country.creador || 'Sin datos' %>

                            </td>

                            <!-- ACTIONS -->

                            <td>

                                <div class="table-actions">

                                    <a
                                        href="/countries/edit/<%= country._id %>"
                                        class="btn btn-edit"
                                    >

                                        Editar

                                    </a>

                                    <form
                                        action="/countries/<%= country._id %>?_method=DELETE"
                                        method="POST"
                                    >

                                        <button
                                            type="submit"
                                            class="btn btn-delete"
                                        >

                                            Eliminar

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>


        <!-- PAGINACIÓN -->

        <div class="pagination">

            <% 
                const queryParams =
                    new URLSearchParams(filters);
            %>

            <!-- BOTÓN ANTERIOR -->

            <% if (page > 1) { %>

                <% queryParams.set('page', page - 1); %>

                <a
                    href="/countries?<%= queryParams.toString() %>"
                    class="pagination-arrow"
                >

                    ←

                </a>

            <% } %>

            <!-- NÚMEROS -->

            <% for(let i = 1; i <= totalPages; i++) { %>

                <% queryParams.set('page', i); %>

                <a
                    href="/countries?<%= queryParams.toString() %>"

                    class="
                        pagination-number
                        <%= page === i ? 'active-page' : '' %>
                    "
                >

                    <%= i %>

                </a>

            <% } %>

            <!-- BOTÓN SIGUIENTE -->

            <% if (page < totalPages) { %>

                <% queryParams.set('page', page + 1); %>

                <a
                    href="/countries?<%= queryParams.toString() %>"
                    class="pagination-arrow"
                >

                    →

                </a>

            <% } %>

        </div>

        <!-- RESUMEN -->

        <div class="dashboard-summary">

            <div class="summary-card">

                <h3>

                    Promedio Gini

                </h3>

                <p>

                    <%= averageGini.toFixed(2) %>

                </p>

            </div>

        </div>

    </div>


    <!-- MODAL DELETE -->

    <div
        id="delete-modal"
        class="delete-modal hidden"
        role="dialog"
        aria-modal="true"
    >

        <div class="delete-modal-content">

            <h3>
                Confirmar eliminación
            </h3>

            <p>
                ¿Seguro que deseas eliminar este país?
            </p>

            <div class="delete-modal-actions">

                <button
                    id="cancel-delete"
                    class="btn btn-secondary"
                >
                    Cancelar
                </button>

                <button
                    id="confirm-delete"
                    class="btn btn-confirm-delete btn-delete"
                >
                    Eliminar
                </button>

            </div>

        </div>

    </div>

    <!--  SCRIPT PARA CONFIRMAR ELIMINACIÓN -->

    <script src="/js/deleteModal.js"></script>

</section>
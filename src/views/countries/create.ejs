<section class="form-section">

    <div class="container">

        <div class="form-header">

            <div>

                <h1 class="form-title">
                    Agregar País
                </h1>

                <p class="form-subtitle">

                    Completa la información del nuevo país
                    hispanohablante.

                </p>

            </div>

            <a
                href="/countries"
                class="btn btn-secondary"
            >

                ← Volver

            </a>

        </div>

        <div class="form-card glass-card">

            <form
                action="/countries"
                method="POST"
                class="country-form"
            >

            <!-- INCLUIMOS EL FORMULARIO REUTILIZABLE -->
            <%- include('../partials/countryForm') %>

            <!-- BOTONES -->

                <div class="form-actions">

                    <button
                        type="submit"
                        class="btn btn-primary"
                    >

                        Guardar País

                    </button>

                    <a
                        href="/countries"
                        class="btn btn-secondary"
                    >

                        Cancelar

                    </a>

                </div>

            </form>

        </div>

    </div>

</section>
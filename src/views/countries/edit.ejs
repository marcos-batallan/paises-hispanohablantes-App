<section class="form-section">

    <div class="container">

        <div class="form-card glass-card">

            <div class="form-header">

                <h1>
                    Editar País
                </h1>

                <p>
                    Actualiza la información del país
                </p>

            </div>

            <form
                action="/countries/<%= country._id %>?_method=PUT"
                method="POST"
                class="country-form"
            >

                <!-- INCLUIMOS EL FORMULARIO REUTILIZABLE -->
                <%- include('../partials/countryForm') %>

                <!-- BOTONES -->

                <div class="form-actions">

                    <button
                        type="submit"
                        class="btn btn-primary"
                    >
                        Guardar cambios
                    </button>

                    <a
                        href="/countries"
                        class="btn btn-secondary"
                    >
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </div>

</section>